{
  "name": "@bluemoon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bluemoon/config": "workspace:*",
    "@bluemoon/database": "workspace:*",
    "@bluemoon/types": "workspace:*",
    "@bluemoon/utils": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.3",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.13",
    "jose": "^5.9.6",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bluemoon/eslint-config": "workspace:*",
    "eslint": "^9.15.0",
    "@bluemoon/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
