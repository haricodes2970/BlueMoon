# apps/server environment variables — see docs/engineering/environment-strategy.md
# and docs/deployment/README.md#production-environment-contract for the
# authoritative development/test/production table.
# Copy to .env.local for local development. Never commit real values.

# development (default) | test | production. Gates the env.ts
# production-only fail-fast checks below, Secure cookies, and
# pretty-vs-JSON logging. Railway/production deploys must set this to
# "production" explicitly -- nothing defaults it there.
NODE_ENV=development

# Required in production -- the server refuses to start in production
# without it (see env.ts). Optional in development so the workspace
# still boots without a database configured yet.
DATABASE_URL=postgres://user:password@localhost:5432/bluemoon_dev
PORT=8787
LOG_LEVEL=info
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-a-real-32-byte-secret-before-running
# Origin allowed to call this API cross-origin -- apps/web's dev server.
# In production, must be the real deployed frontend origin -- the
# server refuses to start in production if this is still the
# localhost default (see env.ts).
WEB_ORIGIN=http://localhost:3000

# bm_refresh cookie's SameSite attribute -- see infrastructure/identity/cookies.ts
# and docs/deployment/README.md. "Lax" (default) is correct when
# apps/web and apps/server share a registrable domain (e.g.
# app.example.com / api.example.com); if they're deployed on two
# unrelated domains (default Vercel/Railway domains), set "None" --
# only valid together with NODE_ENV=production, since a SameSite=None
# cookie must also be Secure.
COOKIE_SAME_SITE=Lax

# Optional: only read by `pnpm test:db` (Milestone 0.8 real-Postgres
# integration tests, see docs/phases/Phase-0.8.md). Falls back to
# DATABASE_URL if unset. Point this at a disposable database --
# these tests TRUNCATE every Identity table between test cases.
# `docker compose up -d postgres` (see root docker-compose.yml)
# provides one locally at the DATABASE_URL default above.
# TEST_DATABASE_URL=postgres://bluemoon:bluemoon@localhost:5432/bluemoon_dev
